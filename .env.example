# Backend configuration (copy these entries to backend/.env).
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/prism
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=https://your-public-api-domain.example
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_CALLBACK_URL=http://localhost:4000/auth/callback
JWT_SECRET=replace_with_a_long_random_secret
GITHUB_WEBHOOK_SECRET=replace_with_an_independent_long_random_secret
OPENROUTER_API_KEY=your_openrouter_api_key

# Frontend configuration (copy this entry to frontend/.env).
VITE_API_URL=http://localhost:4000
